# ---- secrets ----
# The app's Supabase anon key lives in js/config.js and is committed on
# purpose — the anon key is PUBLIC by design (the real security is the
# Row Level Security in database/schema.sql). NEVER commit a
# service_role / secret key.
.env
*.env

# ---- logs ----
*.log

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- local tooling ----
node_modules/
dist/
build/
.vercel/

# ---- Capacitor (generated by tools/build-apk.bat) ----
android/
capacitor.config.json
capacitor.config.ts

# ---- APK build output (keep version.json + the download page, not the binary) ----
apk/*.apk
