# ============================================================================
#  .env.example — Trivia1v1 environment reference
#
#  NOTE: this file is DOCUMENTATION ONLY. Trivia1v1 is a static site — nothing
#  reads a .env at runtime. The values below are baked into js/config.js and
#  shipped to the browser (the Supabase anon key is PUBLIC by design; the real
#  security is the Row Level Security in database/schema.sql).
#
#  Copy this file to .env if you want a local record of your project values,
#  or paste them straight into js/config.js.
# ============================================================================

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key — NEVER put the service_role key here
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# ============================================================================
#  Supabase dashboard checklist (supabase.com -> your project):
#
#  1. Authentication -> Providers -> Email  -> "Confirm email" = OFF
#     (the app signs up with username@triviaduel.local and logs straight in)
#
#  2. Authentication -> Rate Limits
#     set per-project limits for auth + REST so guest abuse is throttled
#
#  3. Realtime -> the `matches` table must be published
#     (database/schema.sql does this automatically on a fresh install)
#
#  4. Run the SQL files in the order shown in database/README.md
# ============================================================================
