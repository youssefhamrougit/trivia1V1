# ============================================================================
#  .env.example — TriviaDuel environment variables (documentation only)
#
#  This app is a STATIC site: it reads its keys from js/config.js, so these
#  variables are NOT read at runtime. They document the keys you get from
#  Supabase (Project Settings -> API) and that you could expose to your host
#  (e.g. Vercel environment variables) if you ever add a build step.
#
#  Copy to .env (git-ignored) and fill in your real values.
# ============================================================================

# ---- public — safe to share (these ship to the browser) --------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# ---- secret — NEVER commit, NEVER share ------------------------------------
# Grants full database access (bypasses Row Level Security). This static app
# has no server, so it does NOT need this key. Rotate it immediately if it
# ever leaks (Dashboard -> Project Settings -> API Keys -> rotate).
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# ---- optional — server-side JWT verification only --------------------------
# Only needed if you verify auth tokens on your own server. The browser app
# doesn't use it.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
